# ═══════════════════════════════════════════════════════════════
# AUTENTICACIÓN REAL (Supabase)
#
# Copiá este archivo como .env y completá los dos valores.
# Sin esto, la app arranca igual pero en modo demo: login con las
# credenciales fijas y registro deshabilitado.
#
# Dónde salen los valores:
#   1. Entrá a https://supabase.com y creá un proyecto (plan gratuito).
#   2. En el panel del proyecto: Settings → API.
#   3. "Project URL" va en VITE_SUPABASE_URL.
#   4. "Project API keys → anon public" va en VITE_SUPABASE_ANON_KEY.
#
# ⚠ Usá SIEMPRE la clave "anon public", nunca la "service_role":
# esta última bypassea todas las reglas de seguridad y no debe salir
# jamás de un servidor.
#
# Ojo: en un sitio estático estas variables se compilan dentro del
# bundle y son visibles para cualquiera. Es lo esperado con la anon key
# — lo que protege los datos es Row Level Security en Supabase.
# ═══════════════════════════════════════════════════════════════

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# ═══════════════════════════════════════════════════════════════
# FIREBASE (recomendado)
#
# El plan gratuito de Supabase pausa el proyecto a los 7 días sin
# uso y hay que despausarlo a mano. Firebase no pausa.
#
# Dónde salen los valores:
#   1. https://console.firebase.google.com → crear proyecto.
#   2. Agregar una app web (</>) y copiar el objeto firebaseConfig.
#   3. Authentication → Sign-in method → habilitar Email/contraseña.
#   4. Firestore Database → crear base en modo producción.
#   5. Publicar las reglas:  npx firebase deploy --only firestore:rules
#
# ⚠ El paso 5 no es opcional. Sin reglas la base queda abierta:
# apiKey y projectId viajan en el bundle y son públicos por diseño.
# Lo que protege los datos es firestore.rules.
# ═══════════════════════════════════════════════════════════════

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
